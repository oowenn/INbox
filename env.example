# Optional overrides (defaults shown in config.py)
# In Docker, the image sets JOBINBOX_PROJECT_ROOT=/app/host (bind mount).
# JOBINBOX_PROJECT_ROOT=/path/to/repo
# Desktop OAuth JSON (Python Gmail client — InstalledAppFlow)
# JOBINBOX_DESKTOP_CREDENTIALS=/absolute/path/to/desktop_credentials.json
# Web OAuth JSON (browser-only; not read by Python Gmail today — reserved / health check)
# JOBINBOX_WEBAPP_CREDENTIALS=/absolute/path/to/webapp_credentials.json
# JOBINBOX_TOKEN=/absolute/path/to/token.json
# JOBINBOX_DB_PATH=/absolute/path/to/jobinbox.db
# Ground-truth / evaluation labels (separate SQLite file; default: truth_dataset.db in project root)
# JOBINBOX_TRUTH_DB_PATH=/absolute/path/to/truth_dataset.db
#
# Truth dataset CLI (from repo root, PYTHONPATH=src or after pip install):
#   python -m jobinbox.cli truth import              # insert new rows only; does not overwrite existing truth rows
#   python -m jobinbox.cli truth import --limit 100
#   python -m jobinbox.cli truth set --gmail-id ID --result-file path/to/result.json
#   python -m jobinbox.cli truth set --gmail-id ID --result-json '{"final":{...},"extraction":{...}}'
#   python -m jobinbox.cli truth show --gmail-id ID --pretty
#   python -m jobinbox.cli truth count
# In Docker: docker compose exec app python -m jobinbox.cli truth import
# JOBINBOX_USER_ID=local-user
# JOBINBOX_MAX_MESSAGES=500
# JOBINBOX_GMAIL_QUERY=in:inbox
# JOBINBOX_OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default Ollama model in config.py: qwen3:1.7b (ollama pull qwen3:1.7b). Override as needed.
# JOBINBOX_OLLAMA_MODEL=qwen3:1.7b
# JOBINBOX_OLLAMA_TIMEOUT_S=180
#
# OpenAI Chat Completions (optional — set provider + key to use instead of Ollama)
# JOBINBOX_LLM_PROVIDER=openai
# JOBINBOX_OPENAI_API_KEY=sk-...
# Or use a standard env name (also read by config):
# OPENAI_API_KEY=sk-...
# JOBINBOX_OPENAI_MODEL=gpt-4o-mini
# JOBINBOX_OPENAI_BASE_URL=https://api.openai.com/v1
# Set to 0 if the model rejects json response_format (older / some third-party endpoints)
# JOBINBOX_OPENAI_JSON_MODE=1
# JOBINBOX_WEB_HOST=127.0.0.1
# JOBINBOX_WEB_PORT=8000
# JOBINBOX_OAUTH_MODE=local_server
# JOBINBOX_OAUTH_PORT=8090
# JOBINBOX_OAUTH_HOST=localhost
# JOBINBOX_OAUTH_BIND_ADDR=
# JOBINBOX_OAUTH_OPEN_BROWSER=1
